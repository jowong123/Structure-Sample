# ============================================
# iOS / Xcode .gitignore
# ============================================

# ---- macOS ----
.DS_Store

# ---- Ruby / Bundler ----
vendor/bundle/
.bundle/


# ---- Xcode user-specific files ----
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Keep shared schemes (commit these so CI and teammates get them)
!*.xcodeproj/xcshareddata/
!*.xcworkspace/xcshareddata/

# Workspace checks file (regenerated by Xcode)
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# ---- Build output ----
build/
DerivedData/
*.xcarchive

# ---- Legacy Xcode (pre-Xcode 4) ----
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ---- Swift Package Manager ----
.build/
.swiftpm/
# Package.resolved: commit it for apps (reproducible builds),
# uncomment to ignore it for libraries.
# Package.resolved

# ---- CocoaPods ----
# Many teams commit Pods/ for reproducibility; uncomment to ignore.
# Pods/
# Keep Podfile.lock committed.

# ---- Carthage ----
Carthage/Build/
Carthage/Checkouts/

# ---- Fastlane ----
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
fastlane/README.md

# ---- Code coverage / test results ----
*.gcno
*.gcda
*.profraw
*.profdata
*.xcresult

# ---- Playgrounds ----
timeline.xctimeline
playground.xcworkspace

# ---- Secrets & environment ----
.env
*.env
# Uncomment if you keep secrets in these files:
# GoogleService-Info.plist
# Secrets.xcconfig

# ---- Editors ----
.idea/
.vscode/
*.swp
*~